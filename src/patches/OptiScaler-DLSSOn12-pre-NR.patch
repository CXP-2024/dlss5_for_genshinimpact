+bool ReadOnDiskBytesAtRva(HMODULE module, const BYTE* address, BYTE* out, size_t count)
+{
+    if (module == nullptr || address == nullptr || out == nullptr || count == 0)
+        return false;
+
+    wchar_t path[MAX_PATH] = {};
+    if (GetModuleFileNameW(module, path, MAX_PATH) == 0)
+        return false;
+
+    HANDLE file = CreateFileW(path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE, nullptr, OPEN_EXISTING,
+                              FILE_ATTRIBUTE_NORMAL, nullptr);
+    if (file == INVALID_HANDLE_VALUE)
+        return false;
+
+    bool ok = false;
+    LARGE_INTEGER size = {};
+    LARGE_INTEGER at = {};
+    BYTE headers[0x1000] = {};
+    DWORD got = 0;
+
+    if (!GetFileSizeEx(file, &size) || size.QuadPart < static_cast<LONGLONG>(sizeof(IMAGE_DOS_HEADER)))
+        goto done;
+    if (!ReadFile(file, headers, sizeof(headers), &got, nullptr) || got < sizeof(IMAGE_DOS_HEADER))
+        goto done;
+
+    {
+        const auto dos = reinterpret_cast<const IMAGE_DOS_HEADER*>(headers);
+        if (dos->e_magic != IMAGE_DOS_SIGNATURE || dos->e_lfanew < 0 ||
+            static_cast<size_t>(dos->e_lfanew) + sizeof(IMAGE_NT_HEADERS64) > got)
+            goto done;
+
+        const auto nt = reinterpret_cast<const IMAGE_NT_HEADERS64*>(headers + dos->e_lfanew);
+        if (nt->Signature != IMAGE_NT_SIGNATURE || nt->OptionalHeader.Magic != IMAGE_NT_OPTIONAL_HDR64_MAGIC)
+            goto done;
+
+        const uintptr_t rva = static_cast<uintptr_t>(address - reinterpret_cast<const BYTE*>(module));
+        const auto sections = IMAGE_FIRST_SECTION(nt);
+        DWORD raw = 0;
+        for (WORD i = 0; i < nt->FileHeader.NumberOfSections; ++i)
+        {
+            const DWORD va = sections[i].VirtualAddress;
+            const DWORD span = sections[i].SizeOfRawData > sections[i].Misc.VirtualSize
+                                   ? sections[i].SizeOfRawData
+                                   : sections[i].Misc.VirtualSize;
+            if (rva >= va && rva + count <= static_cast<uintptr_t>(va) + span)
+            {
+                raw = sections[i].PointerToRawData + static_cast<DWORD>(rva - va);
+                break;
+            }
+        }
+        if (raw == 0 || static_cast<ULONGLONG>(raw) + count > static_cast<ULONGLONG>(size.QuadPart))
+            goto done;
+
+        at.QuadPart = raw;
+    }
+
+    if (!SetFilePointerEx(file, at, nullptr, FILE_BEGIN))
+        goto done;
+    got = 0;
+    ok = ReadFile(file, out, static_cast<DWORD>(count), &got, nullptr) && got == count;
+
+done:
+    CloseHandle(file);
+    return ok;
+}
+
+HRESULT CallNativeD3D12CreateDevice(HMODULE module, PFN_D3D12CreateDevice entry, IUnknown* adapter,
+                                    D3D_FEATURE_LEVEL featureLevel, REFIID riid, void** device)
+{
+    if (entry == nullptr)
+        return E_POINTER;
+
+    static SRWLOCK patchLock = SRWLOCK_INIT;
+    AcquireSRWLockExclusive(&patchLock);
+
+    BYTE current[5] = {};
+    BYTE original[5] = {};
+    memcpy(current, reinterpret_cast<const void*>(entry), sizeof(current));
+    const bool reshadeJump = current[0] == 0xE9 &&
+                             ReadOnDiskBytesAtRva(module, reinterpret_cast<const BYTE*>(entry), original,
+                                                  sizeof(original)) &&
+                             original[0] != 0xE9;
+
+    DWORD exceptionCode = 0;
+    if (!reshadeJump)
+    {
+        const HRESULT result = SafeCreateDevice(entry, adapter, featureLevel, riid, device, &exceptionCode);
+        ReleaseSRWLockExclusive(&patchLock);
+        if (exceptionCode != 0)
+            LOG_ERROR("D3D12CreateDevice raised exception 0x{:X}", exceptionCode);
+        return result;
+    }
+
+    DWORD oldProtection = 0;
+    if (!VirtualProtect(reinterpret_cast<void*>(entry), sizeof(original), PAGE_EXECUTE_READWRITE, &oldProtection))
+    {
+        const DWORD error = GetLastError();
+        ReleaseSRWLockExclusive(&patchLock);
+        LOG_ERROR("Could not bypass ReShade D3D12CreateDevice hook, error {}", error);
+        return HRESULT_FROM_WIN32(error);
+    }
+
+    memcpy(reinterpret_cast<void*>(entry), original, sizeof(original));
+    FlushInstructionCache(GetCurrentProcess(), reinterpret_cast<const void*>(entry), sizeof(original));
+    LOG_INFO("Temporarily bypassing ReShade D3D12CreateDevice hook for private DLSS-on-DX12 device");
+    const HRESULT result = SafeCreateDevice(entry, adapter, featureLevel, riid, device, &exceptionCode);
+
+    memcpy(reinterpret_cast<void*>(entry), current, sizeof(current));
+    FlushInstructionCache(GetCurrentProcess(), reinterpret_cast<const void*>(entry), sizeof(current));
+    DWORD ignored = 0;
+    VirtualProtect(reinterpret_cast<void*>(entry), sizeof(current), oldProtection, &ignored);
+    ReleaseSRWLockExclusive(&patchLock);
+
+    if (exceptionCode != 0)
+        LOG_ERROR("Native D3D12CreateDevice raised exception 0x{:X}", exceptionCode);
+    return result;
+}
+
+const GUID kReShadeUnwrappedObject =
+    { 0x7f2c9a11, 0x3b4e, 0x4d6a, { 0x81, 0x2f, 0x5e, 0x9c, 0xd3, 0x7a, 0x1b, 0x42 } };
+
+IDXGIAdapter* UnwrapReShadeAdapter(IDXGIAdapter* adapter)
+{
+    if (adapter == nullptr)
+        return nullptr;
+
+    IUnknown* nativeUnknown = nullptr;
+    const HRESULT result =
+        adapter->QueryInterface(kReShadeUnwrappedObject, reinterpret_cast<void**>(&nativeUnknown));
+    if (FAILED(result) || nativeUnknown == nullptr)
+        return adapter;
+
+    IDXGIAdapter* nativeAdapter = nullptr;
+    const HRESULT queryResult = nativeUnknown->QueryInterface(IID_PPV_ARGS(&nativeAdapter));
+    nativeUnknown->Release();
+    if (FAILED(queryResult) || nativeAdapter == nullptr)
+        return adapter;
+
+    LOG_INFO("Unwrapped ReShade DXGI adapter for private DLSS-on-DX12 device");
+    return nativeAdapter;
+}
