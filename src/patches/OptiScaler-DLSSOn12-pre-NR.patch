+HRESULT SafeCreateDevice(PFN_D3D12CreateDevice fn, IUnknown* adapter, D3D_FEATURE_LEVEL featureLevel,
+                         REFIID riid, void** device, DWORD* exceptionCode)
+{
+    *exceptionCode = 0;
+    __try
+    {
+        return fn(adapter, featureLevel, riid, device);
+    }
+    __except (EXCEPTION_EXECUTE_HANDLER)
+    {
+        *exceptionCode = GetExceptionCode();
+        return E_FAIL;
+    }
